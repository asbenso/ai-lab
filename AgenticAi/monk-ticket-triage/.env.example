# Copy to .env and fill in. NEVER commit your .env file.
# ---
# OFFLINE / LOCAL DEMO MODE: set MONK_MODEL=fake (and optionally MONK_EMBEDDINGS=fake)
# ---

# --- AWS ---
AWS_REGION=us-east-1
# Optional: boto3 reads ~/.aws/credentials if these are unset.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- GCP (Vertex Agent Engine deploy) ---
GCP_PROJECT=your-gcp-project-id
GCP_LOCATION=us-central1
GCP_BUCKET=your-gcp-project-id-monk-staging

# --- Model selection ---
MONK_MODEL=bedrock_converse:openai.gpt-oss-120b-1:0
MONK_EMBEDDINGS=bedrock:amazon.titan-embed-text-v2:0

# --- LangSmith ---
LANGSMITH_TRACING=true
LANGCHAIN_TRACING_V2=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=monk-ticket-triage
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Postgres / memory ---
# Local Docker: make postgres-up (from Research-Assistant docker-compose, port 5433)
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5433/monk
MONK_MEMORY=postgres

# Cloud SQL direct (deploy + local debug when Docker Postgres is not running)
POSTGRES_DSN_CLOUDSQL_DIRECT=postgresql://postgres:PASSWORD@HOST:5432/monk
CLOUDSQL_CONNECTION_NAME=project:region:instance

# --- Project 2 production checkpoints (App Runner / AgentCore) ---
# Leave unset for local SQLite checkpoints; set for cloud Postgres checkpoints.
# MONK_CHECKPOINT=postgres

# --- Optional ---
# MONK_DOMAIN=it-helpdesk
# THREAD_REGISTRY_PATH=/tmp/monk_threads.json
# BEDROCK_GUARDRAIL_ID=
# BEDROCK_GUARDRAIL_VERSION=DRAFT
